# ScamGuard Backend Configuration Template
# Rename to .env for custom deployment configurations

APP_NAME="ScamGuard AI Detection Engine"
APP_VERSION="1.0.0"
DEBUG=false

# API Prefix
API_V1_PREFIX="/api/v1"

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=120
ALLOWED_ORIGINS=["*"]

# Message constraints (characters)
MAX_MESSAGE_LENGTH=4000
MIN_MESSAGE_LENGTH=1

# Storage
DB_PATH="backend/app/db/scamguard_audit.db"
