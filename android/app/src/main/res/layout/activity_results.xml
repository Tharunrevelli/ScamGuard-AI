<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Truncation Alert Banner -->
        <TextView
            android:id="@+id/textTruncationBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Content Clipped: Message preview was truncated by Android. For complete assurance, share or paste the full message."
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#92400E"
            android:background="#FEF3C7"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Top Classification Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/textClassification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Likely Safe"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/tier_safe"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/textRiskScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Risk Index: 12 / 100"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/textConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confidence Certainty: 92%"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Matched Explanations -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detected Threat Indicators"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/textReasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Recommended Next Actions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suggested Action"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/textActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp" />

        <!-- User Feedback Prompt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnFeedbackAccurate"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="👍 Accurate"
                android:textSize="12sp"
                android:textColor="#16A34A"
                android:background="#DCFCE7"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnFeedbackFalse"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="⚠️ Incorrect"
                android:textSize="12sp"
                android:textColor="#DC2626"
                android:background="#FEE2E2" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Done"
            android:backgroundTint="@color/primary"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>
