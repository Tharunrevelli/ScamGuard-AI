<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🛡️ ScamGuard PRO"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRIVACY SHIELD"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="#DEF7EC"
                android:textColor="#03543F" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zero-knowledge scam protection. Evaluates background chats 100% on-device; strictly filters e-commerce noise &amp; flags clipped previews."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="14dp" />

        <!-- Quick Test Presets Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnPresetPhishing"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Bank Phish"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:background="#EEF2FF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnPresetSafe"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Normal Chat"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:background="#F1F5F9" />
        </LinearLayout>

        <!-- Quick Test Presets Row 2 (Professor Feedback Demonstrations) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnPresetTruncated"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Clipped (...)"
                android:textSize="11sp"
                android:textColor="#D97706"
                android:background="#FEF3C7"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnPresetEcommerce"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Meesho / Ad"
                android:textSize="11sp"
                android:textColor="#4B5563"
                android:background="#E5E7EB" />
        </LinearLayout>

        <!-- Message Input -->
        <EditText
            android:id="@+id/editMessageInput"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/input_background"
            android:gravity="top|start"
            android:hint="@string/prompt_input"
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Dual Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnScanClipboard"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📋 Paste &amp; Scan"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#EEF2FF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnAnalyze"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.3"
                android:text="🔍 Threat Analysis"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp" />

        <!-- Privacy & Scalability Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PRIVACY &amp; NOISE ARCHITECTURE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="8dp" />

            <Switch
                android:id="@+id/switchPrivacyShield"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Local Privacy Shield (100% On-Device, 0 Server Calls)"
                android:textSize="12sp"
                android:checked="true"
                android:layout_marginBottom="6dp" />

            <Switch
                android:id="@+id/switchRedactPii"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Client-Side PII Redaction (Phone / Card / Email)"
                android:textSize="12sp"
                android:checked="true"
                android:layout_marginBottom="6dp" />

            <Switch
                android:id="@+id/switchNotificationListener"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Background Interception Active"
                android:textSize="12sp"
                android:checked="true"
                android:layout_marginBottom="10dp" />

            <!-- Granular App Whitelist Controls -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monitored Communication Channels:"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/checkWhatsApp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WhatsApp"
                    android:textSize="11sp"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/checkSms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SMS / RCS"
                    android:textSize="11sp"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <CheckBox
                    android:id="@+id/checkTelegram"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Telegram"
                    android:textSize="11sp"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/checkEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gmail"
                    android:textSize="11sp"
                    android:checked="true" />
            </LinearLayout>

            <Button
                android:id="@+id/btnNotificationPermission"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="Authorize Notification Access"
                android:textSize="11sp"
                android:backgroundTint="#F8FAFC"
                android:textColor="@color/primary" />
        </LinearLayout>

        <!-- History Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recent Local Scans"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnClearHistory"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Clear"
                android:textSize="11sp"
                android:textColor="#EF4444" />
        </LinearLayout>

        <ListView
            android:id="@+id/listHistory"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@color/card_bg"
            android:divider="#F1F5F9"
            android:dividerHeight="1dp"
            android:layout_marginBottom="16dp" />

        <!-- Backend URL Configuration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cloud API Endpoint (Used for Deep Forensic Scan)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editBackendUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/input_background"
            android:padding="10dp"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="http://172.22.107.154:8000/api/v1" />

    </LinearLayout>

</ScrollView>
